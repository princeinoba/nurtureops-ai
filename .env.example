# Public Supabase identifiers. Safe for the browser; access remains controlled by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL=
APP_URL=http://localhost:3000
CRON_SECRET=
INVITATION_HMAC_SECRET=

# The checked-in portfolio build defaults to deterministic synthetic demo mode.
NURTUREOPS_DEMO_MODE=true
AI_ENABLED=false
